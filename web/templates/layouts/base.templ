package layouts

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/main.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotfshVVFspr4QZSjiDt+uXl6Jc/K+0x2W7iW0Ht6x9Z6O2BLd5nP5n5n5n" crossorigin="anonymous"></script>
			<script src="https://unpkg.com/uplot@1.6.31/dist/uPlot.iife.min.js"></script>
			<link rel="stylesheet" href="https://unpkg.com/uplot@1.6.31/dist/uPlot.min.css"/>
		</head>
		<body class="bg-gray-50 text-gray-900 min-h-screen">
			{ children... }
		</body>
	</html>
}
