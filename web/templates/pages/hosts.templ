package pages

import "github.com/niklucky/signal/internal/storage"
import "github.com/niklucky/signal/web/templates/layouts"
import "github.com/niklucky/signal/web/templates/components"
import "fmt"

templ Hosts(email string, hosts []storage.Host, success string) {
	@layouts.Base("Hosts — Signal") {
		@components.Nav(email)
		<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-semibold text-gray-900">Hosts</h1>
				<a href="/hosts/new" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Add host</a>
			</div>
			@components.Alert(success, "success")
			<div class="mt-6 bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
				if len(hosts) == 0 {
					<p class="p-6 text-sm text-gray-500">No hosts configured yet.</p>
				} else {
					<table class="min-w-full divide-y divide-gray-200">
						<thead class="bg-gray-50">
							<tr>
								<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
								<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">URL</th>
								<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Interval</th>
								<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
								<th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
							</tr>
						</thead>
						<tbody class="bg-white divide-y divide-gray-200">
							for _, h := range hosts {
								<tr>
									<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{ h.Name }</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ h.URL }</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ fmt.Sprintf("%ds", h.IntervalSec) }</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm">
										if h.Active {
											<span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">Active</span>
										} else {
											<span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800">Paused</span>
										}
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
										<a href={ templ.SafeURL(fmt.Sprintf("/hosts/%d", h.ID)) } class="text-indigo-600 hover:text-indigo-900">Edit</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
		</main>
	}
}
