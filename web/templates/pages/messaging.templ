package pages

import "github.com/niklucky/signal/internal/config"
import "github.com/niklucky/signal/web/templates/layouts"
import "github.com/niklucky/signal/web/templates/components"

templ Messaging(email string, cfg *config.Config, success, info string) {
	@layouts.Base("Messaging — Signal") {
		@components.Nav(email)
		<main class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
			<h1 class="text-2xl font-semibold text-gray-900">Messaging config</h1>
			@components.Alert(success, "success")
			@components.Alert(info, "info")
			<form method="post" class="mt-6 bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-6">
				<div>
					<h2 class="text-lg font-medium text-gray-900">Telegram</h2>
					<div class="mt-3 flex items-center gap-2">
						<input type="checkbox" name="telegram_enabled" id="telegram_enabled" checked?={ cfg.Telegram.Enabled } class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"/>
						<label for="telegram_enabled" class="text-sm font-medium text-gray-700">Enabled</label>
					</div>
					<div class="mt-3 space-y-3">
						<div>
							<label for="telegram_bot_token" class="block text-sm font-medium text-gray-700">Bot token</label>
							<input type="text" name="telegram_bot_token" id="telegram_bot_token" value={ cfg.Telegram.BotToken } class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"/>
						</div>
						<div>
							<label for="telegram_chat_id" class="block text-sm font-medium text-gray-700">Chat ID</label>
							<input type="text" name="telegram_chat_id" id="telegram_chat_id" value={ cfg.Telegram.ChatID } class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"/>
						</div>
						<div>
							<label for="telegram_proxy_url" class="block text-sm font-medium text-gray-700">Proxy URL</label>
							<input type="text" name="telegram_proxy_url" id="telegram_proxy_url" value={ cfg.Telegram.ProxyURL } class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"/>
						</div>
					</div>
				</div>
				<div class="border-t border-gray-200 pt-6">
					<h2 class="text-lg font-medium text-gray-900">Matrix</h2>
					<div class="mt-3 flex items-center gap-2">
						<input type="checkbox" name="matrix_enabled" id="matrix_enabled" checked?={ cfg.Matrix.Enabled } class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"/>
						<label for="matrix_enabled" class="text-sm font-medium text-gray-700">Enabled</label>
					</div>
					<div class="mt-3 space-y-3">
						<div>
							<label for="matrix_homeserver" class="block text-sm font-medium text-gray-700">Homeserver</label>
							<input type="url" name="matrix_homeserver" id="matrix_homeserver" value={ cfg.Matrix.Homeserver } class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"/>
						</div>
						<div>
							<label for="matrix_user_id" class="block text-sm font-medium text-gray-700">User ID</label>
							<input type="text" name="matrix_user_id" id="matrix_user_id" value={ cfg.Matrix.UserID } class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"/>
						</div>
						<div>
							<label for="matrix_access_token" class="block text-sm font-medium text-gray-700">Access token</label>
							<input type="password" name="matrix_access_token" id="matrix_access_token" value={ cfg.Matrix.AccessToken } class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"/>
						</div>
						<div>
							<label for="matrix_room_id" class="block text-sm font-medium text-gray-700">Room ID</label>
							<input type="text" name="matrix_room_id" id="matrix_room_id" value={ cfg.Matrix.RoomID } class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"/>
						</div>
					</div>
				</div>
				<div class="flex justify-end gap-3 pt-4">
					<a href="/dashboard" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Cancel</a>
					<button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Save config</button>
				</div>
			</form>
		</main>
	}
}
